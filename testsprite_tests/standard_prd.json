{
  "meta": {
    "project": "TAC - Tapan Air Cargo Platform",
    "date": "2025-12-22",
    "prepared_by": "Software Development Manager"
  },
  "product_overview": "TAC is a comprehensive logistics management platform tailored for cargo companies in India, providing end-to-end shipment tracking, automated invoicing, barcode management, inventory control, and financial analytics with an emphasis on real-time data and regulatory compliance.",
  "core_goals": [
    "Enable efficient shipment lifecycle management from creation to delivery with accurate ETA calculations.",
    "Automate invoicing processes including GST-compliant billing, PDF generation, and multi-channel delivery.",
    "Support industry-standard barcode generation and real-time scan event tracking for shipment visibility.",
    "Provide perpetual inventory management with real-time stock updates and adjustment capabilities.",
    "Facilitate air cargo manifest creation and management for streamlined flight cargo operations.",
    "Maintain a detailed customer database supporting contact, GST, and credit management.",
    "Deliver comprehensive financial reporting including accounts receivable summaries and aging analytics.",
    "Ensure secure authentication with robust role-based access control and data protection measures.",
    "Achieve high system reliability with low API response times and high concurrency support."
  ],
  "key_features": [
    "Shipment Management: Create, track, and update shipments across various transport modes with ETA calculation.",
    "Invoice Management: Auto-generate and manage GST-compliant invoices, generate branded PDFs, track payments, and send notifications via WhatsApp and SMS.",
    "Barcode & Tracking: Generate GS1-compliant and internal barcodes; record package scan events; provide public shipment tracking without login.",
    "Inventory Management: Real-time perpetual inventory with stock adjustments, low stock alerts, and warehouse location tracking.",
    "Manifest Management: Create and update air cargo manifests grouping shipments by origin and destination with reconciliation.",
    "Customer Management: Manage shipper and consignee details, contacts, GST information, and credit limits.",
    "Financial Analytics: View accounts receivable summaries and aging reports to monitor outstanding invoices and cash flow.",
    "Authentication & Security: Use Supabase Auth for secure login, session management, and enforce role-based access control with row-level security.",
    "API Performance & Stability: APIs designed for under 500ms responses, support 100+ concurrent users, with rate limiting and 99.9% uptime target."
  ],
  "user_flow_summary": [
    "User logs in securely via Supabase Auth with credentials and assigned role determining access level.",
    "Admin or Manager creates shipments entering origin, destination, and transport mode, then tracks status changes and ETA.",
    "Operator scans packages recording scan events linked to barcodes for real-time shipment progress updates.",
    "Finance or Manager users create invoices linked to shipments, generate PDFs, and send them through WhatsApp or SMS.",
    "Inventory managers adjust stock levels based on inbound, outbound, and cycle count processes, monitoring low stock alerts.",
    "Users view customer details and update contact and GST information as required.",
    "Finance users access Accounts Receivable dashboards showing outstanding balances and aging details.",
    "External customers use the public tracking portal to search shipments by shipment ref, invoice ref, or barcode without authentication."
  ],
  "validation_criteria": [
    "APIs respond within 500ms under normal and peak loads supporting 100+ concurrent users.",
    "Role-based access control prevents unauthorized data access; users only see data permitted by their roles.",
    "Invoices correctly generated with GST calculations and PDFs include company branding and accurate data.",
    "Barcode generation complies with GS1 standards and internal formats, validated by automated tests.",
    "Scan events record accurately and reflect real-time package movements in shipment timelines.",
    "Inventory adjustments update stock in real-time with correct location and reason tracking; alerts trigger on low stock.",
    "Financial reports match invoice and payment data with accurate aging classifications.",
    "Public tracking returns correct shipment status and timelines without requiring authentication.",
    "System uptime monitored at 99.9% with error tracking via Sentry and performance analytics through Vercel Analytics.",
    "Rate limiting enforced on all endpoints to prevent abuse, validated by load tests and logs."
  ],
